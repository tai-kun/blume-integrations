---
import data from "blume:data";
import { type RedirectPathProps, getRedirectPaths } from "./redirect-paths.js";

/**
 * デフォルトロケールのプレフィックス付き URL ごとに、プレフィックスなしの URL へ転送するページを生成します。
 */
export function getStaticPaths() {
  return getRedirectPaths(data, import.meta.env?.BASE_URL);
}

const { targets } = Astro.props as RedirectPathProps;
// 転送先はデフォルトロケールの正規 URL だけです。
const target = targets[0];
---

<html lang={target?.code ?? "en"}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark light">
    <style is:inline>
      /* 転送が完了するまでの一瞬だけ内容が表示されるのを防ぎます。 */
      body {
        animation: show-content 1s step-end;
      }

      @keyframes show-content {
        from {
          visibility: hidden;
        }

        to {
          visibility: visible;
        }
      }
    </style>
    <noscript>
      <style is:inline>
        /* JavaScript が動かない場合は転送できないため、最初から内容を表示します。 */
        body {
          animation: none;
          visibility: visible;
        }
      </style>
    </noscript>
    {
      target && (
        <script is:inline define:vars={{ href: target.href }}>
          window.location.replace(
            href + window.location.search + window.location.hash,
          );
        </script>
      )
    }
  </head>

  <body>
    <h1>Redirecting...</h1>
    <p>If you are not redirected automatically, or if you are an AI agent or a client that does not run JavaScript, open this page:</p>
    <ul>
      {
        targets.map((target) => (
          <li>
            <a href={target.href} hreflang={target.code} lang={target.code}>
              {target.label}
            </a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
